# AI Study Assistant - Backend Environment Variables
# Copy this file to .env and fill in the values:
#   cp .env.example .env

# JWT signing secret - generate a random one:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=insecure-dev-secret-change-me

# JWT settings
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# SQLite database (local file)
DATABASE_URL=sqlite:///./study_assistant.db

# Groq AI - REQUIRED for all AI features
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# CORS - comma-separated list of allowed frontend origins
# For local dev: the Vite dev server
# For production: your Vercel frontend URL
CORS_ORIGINS=http://localhost:5173

# Uploads
MAX_UPLOAD_SIZE_MB=15
UPLOAD_DIR=uploads
